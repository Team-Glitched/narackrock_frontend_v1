# Only application inputs enter the build context.
**
!package.json
!package-lock.json
!.npmrc
!scripts/
!scripts/install-ci.mjs
!src/
!src/**
!public/
!public/**
!index.html
!tsconfig.json
!vite.config.ts
!postcss.config.mjs
!tailwind.config.ts
!nginx.conf

# Never include local environment, dependencies, or generated output.
**/.env*
**/.git
**/node_modules
**/dist
**/build
**/out
**/coverage
**/.vite
**/.cache
**/*.tsbuildinfo
