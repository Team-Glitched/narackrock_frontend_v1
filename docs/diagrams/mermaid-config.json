{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Apple SD Gothic Neo, Arial, sans-serif",
    "fontSize": "18px",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#172033",
    "primaryBorderColor": "#64748b",
    "lineColor": "#64748b",
    "secondaryColor": "#f8fafc",
    "tertiaryColor": "#ffffff",
    "edgeLabelBackground": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "linear",
    "nodeSpacing": 32,
    "rankSpacing": 44,
    "padding": 16,
    "useMaxWidth": false,
    "wrappingWidth": 400
  },
  "securityLevel": "strict",
  "look": "classic",
  "htmlLabels": false,
  "markdownAutoWrap": false,
  "themeCSS": ".node rect, .node circle, .node polygon, .node .outer-path { filter: none !important; }"
}
