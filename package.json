{
  "name": "narackrock-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "native:install": "npm --prefix native install",
    "native:web": "tsc --noEmit && node scripts/build-native-web.mjs",
    "native:prebuild": "npm --prefix native run prebuild",
    "native:android": "npm run native:web && npm --prefix native run android",
    "native:android:release": "npm run native:web && npm --prefix native run android:release",
    "native:android:bundle": "npm run native:web && npm --prefix native run android:bundle",
    "native:ios": "npm run native:web && npm --prefix native run ios",
    "native:ios:release": "npm run native:web && npm --prefix native run ios:release"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.5.0",
    "@tanstack/react-query": "^5.106.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.18.5",
    "tailwind-merge": "3.6.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "prettier": "3.8.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
